{
  "name": "surf-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:ui": "turbo run build --filter=@surf/ui",
    "dev": "turbo run dev",
    "dev:surf": "turbo run dev --filter=surf-web",
    "lint": "turbo run lint",
    "lint:surf": "turbo run lint --filter=surf-web",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "storybook:ui": "turbo run storybook --filter=@surf/ui",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "pnpm --filter surf-web exec eslint --max-warnings=0 --fix --no-warn-ignored",
      "pnpm exec prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": "pnpm exec prettier --write",
    "*.{json,md,css,scss,html}": "pnpm exec prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@surf/prettier-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.7.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=18"
  }
}
