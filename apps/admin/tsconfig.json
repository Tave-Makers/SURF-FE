{
  "extends": "@surf/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@surf/hooks": ["../../packages/hooks/index.ts"],
      "@surf/utils": ["../../packages/utils/index.ts"],
      "@surf/ui/store/*": ["../../packages/ui/store/*"],
      "@surf/ui/lib/*": ["../../packages/ui/lib/*"],
      "@surf/ui/hooks/*": ["../../packages/ui/hooks/*"],
      "@surf/ui/styles/*": ["../../packages/ui/styles/*"],
      "@surf/ui/assets/*": ["../../packages/ui/assets/*"],
      "@surf/ui/*": ["../../packages/ui/components/*/index.ts"]
    }
  },
  "include": ["svgr.d.ts", "next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    ".storybook",
    "**/*.stories.*",
    "**/*.test.*",
    "src/test",
    "vitest.config.ts",
    "vitest.shims.d.ts",
    "scripts"
  ]
}
