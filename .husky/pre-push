set -eu

echo "🔍 브랜치 네이밍 규칙 검사 실행"
had_input=false
while read -r local_ref local_sha remote_ref remote_sha; do
  had_input=true
  case "$remote_ref" in
    refs/tags/*) continue ;;
  esac

  branch_name="${remote_ref#refs/heads/}"
  case "$branch_name" in
    main|develop) continue ;;
  esac

  if ! echo "$branch_name" | grep -Eq '^(feat|fix|hotfix|refactor|style|docs|chore|test|release)/[a-z0-9._-]+$'; then
    echo "❌ 브랜치 네이밍 규칙 위반"
    exit 1
  fi
done

if [ "$had_input" = false ]; then
  branch_name="$(git rev-parse --abbrev-ref HEAD || echo '')"
  case "$branch_name" in
    ""|HEAD|main|develop) : ;;
    *)
      if ! echo "$branch_name" | grep -Eq '^(feat|fix|hotfix|refactor|style|docs|chore|test|release)/[a-z0-9._-]+$'; then
        echo "❌ 브랜치 네이밍 규칙 위반"
        exit 1
      fi
      ;;
  esac
fi
echo "✅ 브랜치 네이밍 규칙 통과"

echo "🔍 빌드 확인"
pnpm turbo run build
echo "✅ 빌드 성공"

echo "🚀 push 진행"
