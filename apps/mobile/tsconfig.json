{
  "extends": ["expo/tsconfig.base", "@surf/typescript-config/base.json"],
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
