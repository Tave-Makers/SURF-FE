{
  "name": "@surf/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/styles dist/assets && cp -R styles dist/styles && cp -R assets dist/assets",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "exports": {
    "./styles/globals.css": "./dist/styles/globals.css",
    "./styles/*": "./dist/styles/*",
    "./assets/*": "./dist/assets/*",
    "./assets/*/*": "./dist/assets/*/*",
    "./*": {
      "types": "./dist/ui/*/index.d.ts",
      "default": "./dist/ui/*/index.js"
    },
    "./store/*": {
      "types": "./dist/store/*.d.ts",
      "default": "./dist/store/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./*/*": {
      "types": "./dist/ui/*/*.d.ts",
      "default": "./dist/ui/*/*.js"
    },
    "./*/*/*": {
      "types": "./dist/ui/*/*/*.d.ts",
      "default": "./dist/ui/*/*/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@mynaui/icons-react": "^0.3.9",
    "keen-slider": "^6.8.6",
    "react-modal-sheet": "^5.1.2",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "tailwindcss": "^4",
    "react": "^19",
    "react-dom": "^19",
    "next": "^15"
  },
  "devDependencies": {
    "@surf/typescript-config": "workspace:*",
    "@chromatic-com/storybook": "4.1.1",
    "@storybook/addon-a11y": "9.1.16",
    "@storybook/addon-docs": "9.1.16",
    "@storybook/builder-webpack5": "~9.1.16",
    "@storybook/nextjs": "~9.1.16",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.16",
    "storybook": "9.1.16",
    "webpack": "^5.102.1"
  }
}
